{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-scala:schema:point-evidence-result:v2",
  "title": "semantic-scala point evidence result v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "workspace", "sourceFile", "position", "discovery", "selection", "livePoint", "reconciliation"],
  "properties": {
    "schemaVersion": { "const": "semantic-scala.point-evidence-result.v2" },
    "workspace": { "type": "string" }, "sourceFile": { "type": "string" },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["line", "column", "encoding"],
      "properties": { "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }, "encoding": { "const": "UTF-16" } }
    },
    "discovery": { "$ref": "#/$defs/discovery" },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["status", "artifact", "reason"],
      "properties": {
        "status": { "enum": ["SelectedFresh", "SelectedUnverifiable", "NotSelectedStale", "NotSelectedNoCandidate", "NotSelectedAmbiguous", "NotSelectedPartialOrUnparseable", "NotSelectedUnavailable"] },
        "artifact": { "oneOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] }, "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["SelectedFresh", "SelectedUnverifiable", "NotSelectedStale"] } }, "required": ["status"] }, "then": { "properties": { "artifact": { "$ref": "#/$defs/candidate" } } } },
        { "if": { "properties": { "status": { "enum": ["NotSelectedNoCandidate", "NotSelectedAmbiguous", "NotSelectedPartialOrUnparseable"] } }, "required": ["status"] }, "then": { "properties": { "artifact": { "type": "null" } } } }
      ]
    },
    "livePoint": {
      "type": "object", "additionalProperties": false, "required": ["status", "result", "reason"],
      "properties": { "status": { "enum": ["Resolved", "Unresolved", "Unavailable"] }, "result": { "oneOf": [{ "$ref": "#/$defs/liveResult" }, { "type": "null" }] }, "reason": { "type": ["string", "null"] } },
      "allOf": [
        { "if": { "properties": { "status": { "const": "Unavailable" } }, "required": ["status"] }, "then": { "properties": { "result": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "status": { "enum": ["Resolved", "Unresolved"] } }, "required": ["status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/liveResult" }, "reason": { "type": "null" } } } }
      ]
    },
    "reconciliation": { "$ref": "#/$defs/reconciliation" }
  },
  "$defs": {
    "range": {
      "type": "object", "additionalProperties": false, "required": ["startLine", "startCharacter", "endLine", "endCharacter"],
      "properties": { "startLine": { "type": "integer", "minimum": 0 }, "startCharacter": { "type": "integer", "minimum": 0 }, "endLine": { "type": "integer", "minimum": 0 }, "endCharacter": { "type": "integer", "minimum": 0 } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "documentUri", "documentIndex", "semanticdbMd5", "sourceMd5", "sourceSnapshotSha256", "artifactSnapshotSha256", "sourceMtimeMillis", "artifactMtimeMillis", "detailCode"],
      "properties": {
        "basis": { "enum": ["SemanticdbMd5Utf8", "EmbeddedTextExact", "None"] }, "documentUri": { "type": ["string", "null"] }, "documentIndex": { "type": ["integer", "null"], "minimum": 0 },
        "semanticdbMd5": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" }, "sourceMd5": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "sourceSnapshotSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "artifactSnapshotSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "sourceMtimeMillis": { "type": ["integer", "null"] }, "artifactMtimeMillis": { "type": ["integer", "null"] }, "detailCode": { "type": ["string", "null"] }
      }
    },
    "unverifiableReason": { "enum": ["MissingDocumentIdentity", "MalformedDocumentDigest", "InconsistentDocumentIdentity", "InvalidSourceEncoding", "UnsupportedSourceEncodingOrBom", "NoUniqueDocumentForSource", "AmbiguousDocumentIdentity", "SourceUnreadable"] },
    "freshness": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "reason", "beforeSha256", "afterSha256", "evidence"], "properties": { "status": { "enum": ["Fresh", "Stale"] }, "reason": { "type": "null" }, "beforeSha256": { "type": "null" }, "afterSha256": { "type": "null" }, "evidence": { "$ref": "#/$defs/evidence" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "reason", "beforeSha256", "afterSha256", "evidence"], "properties": { "status": { "const": "Unverifiable" }, "reason": { "$ref": "#/$defs/unverifiableReason" }, "beforeSha256": { "type": "null" }, "afterSha256": { "type": "null" }, "evidence": { "$ref": "#/$defs/evidence" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "reason", "beforeSha256", "afterSha256", "evidence"], "properties": { "status": { "const": "SourceChangedDuringRequest" }, "reason": { "type": "null" }, "beforeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "afterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "evidence": { "$ref": "#/$defs/evidence" } } }
      ]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticdb", "uri", "parseStatus", "matchKind", "symbols", "occurrences", "mtimeMillis", "error", "documentCount", "documentUri", "documentIndex", "artifactSnapshotSha256", "freshness"],
      "properties": {
        "semanticdb": { "type": "string" }, "uri": { "type": ["string", "null"] }, "parseStatus": { "enum": ["Parsed", "Unparseable"] }, "matchKind": { "enum": ["UriExact", "MetaInfSuffix", "SourceRootSuffix"] },
        "symbols": { "type": ["integer", "null"], "minimum": 0 }, "occurrences": { "type": ["integer", "null"], "minimum": 0 }, "mtimeMillis": { "type": "integer" }, "error": { "type": ["string", "null"] },
        "documentCount": { "type": ["integer", "null"], "minimum": 1 }, "documentUri": { "type": ["string", "null"] }, "documentIndex": { "type": ["integer", "null"], "minimum": 0 },
        "artifactSnapshotSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "freshness": { "oneOf": [{ "$ref": "#/$defs/freshness" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "parseStatus": { "const": "Parsed" } }, "required": ["parseStatus"] }, "then": { "properties": { "documentCount": { "type": "integer", "minimum": 1 }, "artifactSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "freshness": { "$ref": "#/$defs/freshness" }, "error": { "type": "null" } } } },
        { "if": { "properties": { "parseStatus": { "const": "Unparseable" } }, "required": ["parseStatus"] }, "then": { "properties": { "documentCount": { "type": "null" }, "artifactSnapshotSha256": { "type": "null" }, "freshness": { "type": "null" }, "error": { "type": "string" } } } }
      ]
    },
    "discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "workspace", "sourceFile", "sourceRelativePath", "status", "semanticdbFiles", "parseableFiles", "unparseableFiles", "matches", "candidatesConsidered", "warnings", "errors"],
      "properties": {
        "schemaVersion": { "const": "semantic-scala.semanticdb-for-source.v2" }, "workspace": { "type": "string" }, "sourceFile": { "type": "string" }, "sourceRelativePath": { "type": ["string", "null"] },
        "status": { "enum": ["UniqueMatch", "NoMatch", "Ambiguous", "Unavailable", "Unparseable", "Partial"] }, "semanticdbFiles": { "type": "integer", "minimum": 0 },
        "parseableFiles": { "type": "integer", "minimum": 0 }, "unparseableFiles": { "type": "integer", "minimum": 0 }, "matches": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "candidatesConsidered": { "type": "integer", "minimum": 0 }, "warnings": { "type": "array", "items": { "type": "string" } }, "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "liveResult": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "symbol", "displayName", "range", "source"],
      "properties": { "schemaVersion": { "const": "semantic-scala.symbol-at-result.v1" }, "symbol": { "type": ["string", "null"] }, "displayName": { "type": ["string", "null"] }, "range": { "oneOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }] }, "source": { "type": "string" } }
    },
    "symbolResult": {
      "type": "object", "additionalProperties": false, "required": ["semanticdbSymbol", "compilerSymbol", "displayName", "range", "status"],
      "properties": { "semanticdbSymbol": { "type": ["string", "null"] }, "compilerSymbol": { "type": ["string", "null"] }, "displayName": { "type": ["string", "null"] }, "range": { "oneOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }] }, "status": { "enum": ["ExactMatch", "RangeMatchOnly", "SymbolMismatch", "NoMatch"] } }
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "result", "qualificationReason", "notAttemptedReason"], "properties": { "status": { "const": "CompletedFresh" }, "result": { "$ref": "#/$defs/symbolResult" }, "qualificationReason": { "type": "null" }, "notAttemptedReason": { "type": "null" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "result", "qualificationReason", "notAttemptedReason"], "properties": { "status": { "const": "CompletedQualifiedUnverifiable" }, "result": { "$ref": "#/$defs/symbolResult" }, "qualificationReason": { "$ref": "#/$defs/unverifiableReason" }, "notAttemptedReason": { "type": "null" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "result", "qualificationReason", "notAttemptedReason"], "properties": { "status": { "const": "NotAttempted" }, "result": { "type": "null" }, "qualificationReason": { "type": "null" }, "notAttemptedReason": { "enum": ["StaleArtifact", "SourceChangedDuringRequest", "NoArtifactCandidate", "AmbiguousArtifactCandidates", "PartialOrUnparseableArtifactEvidence", "ArtifactEvidenceUnavailable", "LivePointUnavailable", "SelectedArtifactUnreadable", "SelectedArtifactChangedOrRemapped"] } } }
      ]
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "file", "semanticdb", "queryPosition", "freshness", "outcome"],
      "properties": { "schemaVersion": { "const": "semantic-scala.reconcile-symbol-result.v2" }, "file": { "type": "string" }, "semanticdb": { "type": ["string", "null"] }, "queryPosition": { "$ref": "#/$defs/range" }, "freshness": { "oneOf": [{ "$ref": "#/$defs/freshness" }, { "type": "null" }] }, "outcome": { "$ref": "#/$defs/outcome" } },
      "allOf": [
        { "if": { "properties": { "outcome": { "properties": { "status": { "const": "CompletedFresh" } }, "required": ["status"] } }, "required": ["outcome"] }, "then": { "properties": { "freshness": { "properties": { "status": { "const": "Fresh" } }, "required": ["status"] } } } },
        { "if": { "properties": { "outcome": { "properties": { "status": { "const": "CompletedQualifiedUnverifiable" } }, "required": ["status"] } }, "required": ["outcome"] }, "then": { "properties": { "freshness": { "properties": { "status": { "const": "Unverifiable" } }, "required": ["status"] } } } },
        { "if": { "properties": { "freshness": { "properties": { "status": { "const": "Stale" } }, "required": ["status"] } }, "required": ["freshness"] }, "then": { "properties": { "outcome": { "properties": { "status": { "const": "NotAttempted" }, "notAttemptedReason": { "const": "StaleArtifact" } }, "required": ["status", "notAttemptedReason"] } } } },
        { "if": { "properties": { "freshness": { "properties": { "status": { "const": "SourceChangedDuringRequest" } }, "required": ["status"] } }, "required": ["freshness"] }, "then": { "properties": { "outcome": { "properties": { "status": { "const": "NotAttempted" }, "notAttemptedReason": { "const": "SourceChangedDuringRequest" } }, "required": ["status", "notAttemptedReason"] } } } },
        { "if": { "properties": { "freshness": { "type": "null" } }, "required": ["freshness"] }, "then": { "properties": { "outcome": { "properties": { "status": { "const": "NotAttempted" } }, "required": ["status"] } } } }
      ]
    }
  }
}
